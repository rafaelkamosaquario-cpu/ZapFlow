# ---------------------------------------------------------------------------
# Modo arquivos (legado, dev local, single-tenant — usado só quando
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY abaixo NÃO estão preenchidos).
# ---------------------------------------------------------------------------

# Credenciais da Z-API (https://app.z-api.io) — só usadas no modo arquivos.
# Em modo Supabase, cada empresa tem suas próprias credenciais, cadastradas
# via scripts/create-company.mjs (nunca em variável de ambiente).
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# Porta do servidor web (opcional)
PORT=3000

# Intervalo padrão entre os envios em milissegundos (opcional). Padrão: 3000 (3s)
# Obs.: existe um piso de segurança de 8000ms (8s) no código — valores menores
# que isso (aqui ou enviados por requisição) são elevados automaticamente.
DEFAULT_DELAY_MS=3000

# Login simples do modo arquivos (opcional). Se preencher AMBOS, o app exige
# login. Se deixar em branco, o app fica aberto (sem login). Em modo Supabase
# essas duas variáveis são ignoradas — o login passa a ser por empresa/usuário
# (tabela `usuarios`, ver scripts/create-company.mjs), sempre obrigatório.
APP_USER=
APP_PASSWORD=

# Pasta onde os dados são salvos NO MODO DE ARQUIVOS (usado apenas quando o
# Supabase NÃO está configurado). No Railway, aponte para um volume. Ex.: /data
# DATA_DIR=/data

# ---------------------------------------------------------------------------
# Supabase (banco de dados central, multi-empresa). Se preencher AMBOS, o
# ZapFlow passa a usar o Supabase como fonte da verdade (em vez de arquivos
# locais) e exige login real por empresa/usuário.
# A SERVICE_ROLE_KEY é secreta e fica SOMENTE no backend — nunca no navegador.
# ---------------------------------------------------------------------------
# URL do projeto (Supabase > Project Settings > API > Project URL)
SUPABASE_URL=

# Service role key (Supabase > Project Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatório quando SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY estão preenchidos:
# segredo usado para assinar o cookie de sessão dos usuários (owner/vendedor).
# Gere um valor aleatório de 32+ bytes uma única vez por ambiente, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem essa variável, o servidor recusa subir em modo Supabase.
SESSION_SECRET=

# Onboarding de empresa nova (modo Supabase): não é uma variável do app, é
# usada só na hora de rodar `node scripts/create-company.mjs` (ver esse
# arquivo). Cada empresa criada recebe uma URL de webhook própria
# (/api/webhook/{empresaId}/{secret}) para configurar no painel da Z-API
# daquela instância — não existe mais uma URL de webhook global única.

# ---------------------------------------------------------------------------
# Google conectado (V3 — Calendar/Sheets/Drive). Cada empresa conecta a
# PRÓPRIA conta Google (OAuth feito pelo dono) — estas 3 variáveis abaixo são
# do app inteiro (o mesmo Client ID/Secret vale pra todas as empresas), não
# por empresa. Sem elas, a aba "Calendário" mostra a integração como não
# configurada, sem quebrar o resto do app.
# ---------------------------------------------------------------------------
# Google Cloud Console > APIs e Serviços > Credenciais > OAuth 2.0 Client ID
# (tipo "Aplicativo da Web"). Ative antes: Calendar API, Sheets API, Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública de produção, SEM barra no final (precisa bater exatamente com o
# redirect URI cadastrado no Google Cloud: {PUBLIC_URL}/auth/google/callback).
# Nunca derive isso de headers da requisição — Railway fica atrás de proxy.
PUBLIC_URL=https://frota-bot-production.up.railway.app
