# Credenciais da Z-API (https://app.z-api.io)
# Você encontra esses dados no painel da sua instância.

# ID da instância
ZAPI_INSTANCE_ID=

# Token da instância
ZAPI_INSTANCE_TOKEN=

# Token de segurança da conta (Client-Token) - aba "Segurança" no painel da Z-API
ZAPI_CLIENT_TOKEN=

# Porta do servidor web (opcional)
PORT=3000

# Intervalo padrão entre os envios em milissegundos (opcional)
DEFAULT_DELAY_MS=1500

# Pasta onde os agendamentos são salvos (opcional).
# No Railway, aponte para o caminho de um volume para não perder os
# agendamentos a cada deploy. Ex.: /data
# DATA_DIR=/data
