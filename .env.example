# Credenciais da Z-API (https://app.z-api.io)
# Você encontra esses dados no painel da sua instância.

# ID da instância
ZAPI_INSTANCE_ID=

# Token da instância
ZAPI_INSTANCE_TOKEN=

# Token de segurança da conta (Client-Token) - aba "Segurança" no painel da Z-API
ZAPI_CLIENT_TOKEN=

# Porta do servidor web (opcional)
PORT=3000

# Intervalo padrão entre os envios em milissegundos (opcional). Padrão: 3000 (3s)
DEFAULT_DELAY_MS=3000

# Login simples (opcional). Se preencher AMBOS, o app exige login.
# Se deixar em branco, o app fica aberto (sem login).
APP_USER=
APP_PASSWORD=

# Pasta onde os dados são salvos NO MODO DE ARQUIVOS (usado apenas quando o
# Supabase NÃO está configurado). No Railway, aponte para um volume. Ex.: /data
# DATA_DIR=/data

# ---------------------------------------------------------------------------
# Supabase (banco de dados central). Se preencher AMBOS, o ZapFlow passa a
# usar o Supabase como fonte da verdade (em vez de arquivos locais).
# A SERVICE_ROLE_KEY é secreta e fica SOMENTE no backend — nunca no navegador.
# ---------------------------------------------------------------------------
# URL do projeto (Supabase > Project Settings > API > Project URL)
SUPABASE_URL=

# Service role key (Supabase > Project Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=
