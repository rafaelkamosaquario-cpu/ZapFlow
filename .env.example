# Credenciais da Z-API (https://app.z-api.io)
# Você encontra esses dados no painel da sua instância.

# ID da instância
ZAPI_INSTANCE_ID=

# Token da instância
ZAPI_INSTANCE_TOKEN=

# Token de segurança da conta (Client-Token) - aba "Segurança" no painel da Z-API
ZAPI_CLIENT_TOKEN=

# Porta do servidor web (opcional)
PORT=3000

# Intervalo padrão entre os envios em milissegundos (opcional). Padrão: 3000 (3s)
DEFAULT_DELAY_MS=3000

# Login simples (opcional). Se preencher AMBOS, o app exige login.
# Se deixar em branco, o app fica aberto (sem login).
APP_USER=
APP_PASSWORD=

# Pasta onde os dados são salvos (agendamentos, métricas e modelos).
# No Railway, aponte para o caminho de um volume para não perder os
# dados a cada deploy. Ex.: /data
# DATA_DIR=/data
