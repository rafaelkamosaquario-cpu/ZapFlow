# Frota IA Assistente
#
# Fase 2 (chat real): a rota /api/chat usa esta chave para falar com a
# Claude API (tool use com as 12 ferramentas de src/ai/tools). Sem ela, o
# chat responde com erro 503 explicando que a integração não está
# configurada — nunca falha silenciosamente nem simula uma resposta falsa.
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Camada 3 — Supabase (identidade, dados e memória do cliente)
# ─────────────────────────────────────────────────────────────────────────
# Projeto Supabase próprio e isolado do Frota IA (não é o mesmo projeto do
# ZapFlow). URL e publishable key são seguras para o navegador — por isso o
# prefixo NEXT_PUBLIC_. A secret key NUNCA leva esse prefixo e nunca deve
# aparecer em código client-side.

NEXT_PUBLIC_SUPABASE_URL=https://kqquswdrtcqicyfcvvuv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_rijl-1HgEgArx4kDKCSg9A_iCwPsT7q

# Secret key (antigo "service role"). Somente backend — nunca no navegador,
# nunca em log, nunca com prefixo NEXT_PUBLIC_. Pegue o valor real no painel
# do Supabase (Project Settings > API Keys) e cole apenas no seu .env local
# (nunca neste arquivo .env.example, nunca commitado).
# SUPABASE_SECRET_KEY=

# Referência do projeto (usada por scripts/CLI, não em runtime da aplicação).
SUPABASE_PROJECT_REF=kqquswdrtcqicyfcvvuv

# ─────────────────────────────────────────────────────────────────────────
# Login com Google (via Supabase Auth) — preparado, pendente de credenciais
# ─────────────────────────────────────────────────────────────────────────
# O client secret do Google fica configurado no painel do Supabase
# (Authentication > Providers > Google), não é lido diretamente pelo
# Next.js. As variáveis abaixo documentam o que precisa existir e, quando
# preenchidas, permitem exibir o Client ID/URI de redirect na própria UI se
# necessário. Nunca commitar valores reais.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://kqquswdrtcqicyfcvvuv.supabase.co/auth/v1/callback

# ─────────────────────────────────────────────────────────────────────────
# Camada 4 — Google Calendar (OAuth complementar, fora do Supabase Auth)
# ─────────────────────────────────────────────────────────────────────────
# O login acima (Supabase Auth) autentica QUEM é o usuário, mas não garante
# um refresh token de longa duração para chamar a API do Calendar depois.
# Por isso este é um fluxo OAuth separado, direto com o Google
# (src/lib/google/calendarClient.ts), com escopos mínimos
# (calendar.readonly + calendar.events). Pode reutilizar o MESMO Client
# ID/Secret do login acima — só é preciso cadastrar as DUAS redirect URIs
# (a do Supabase e a deste módulo) no mesmo OAuth Client no Google Cloud.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/auth/calendar/callback

# Chave para assinar (HMAC-SHA256) o parâmetro `state` do OAuth e o link
# seguro de conexão enviado pelo WhatsApp — nunca usada para criptografar o
# refresh token em si (isso é feito pelo Supabase Vault, já habilitado no
# projeto — ver migration create_google_calendar_vault). Gerar um valor
# aleatório longo, ex.: `openssl rand -base64 32`. Nunca commitar o valor
# real.
# GOOGLE_CALENDAR_ENCRYPTION_KEY=

# URL pública da aplicação (usada para montar os links seguros de conexão
# enviados pelo WhatsApp — Agenda e vínculo de número).
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────
# Camada 5 — WhatsApp (Z-API), canal principal do Frota IA
# ─────────────────────────────────────────────────────────────────────────
# Instância e número PRÓPRIOS do Frota IA — NÃO reaproveitar as credenciais
# do ZapFlow (o outro app deste repositório, na raiz). São dois projetos
# separados, cada um com sua própria instância Z-API. Crie uma instância
# nova em https://app.z-api.io dedicada ao Frota IA.

# ID e token da instância (painel da instância no Z-API)
# ZAPI_INSTANCE_ID=
# ZAPI_INSTANCE_TOKEN=

# Client-Token da conta (aba "Segurança" no painel do Z-API) — vai no
# header Client-Token de toda chamada de envio.
# ZAPI_CLIENT_TOKEN=

# Segredo próprio (gerar com `openssl rand -base64 32`) usado em dois
# lugares: (1) validar que uma chamada em /api/whatsapp/webhook realmente
# veio da sua instância Z-API — configure no painel do Z-API a URL do
# webhook como "${APP_URL}/api/whatsapp/webhook?token=<este valor>"; e
# (2) assinar (HMAC) o link enviado por WhatsApp para vincular um número
# desconhecido à conta do usuário. Nunca commitar o valor real.
# WHATSAPP_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Camada 6 — V1 centrada no WhatsApp (feature flags do painel web)
# ─────────────────────────────────────────────────────────────────────────
# Cliente comum usa só o WhatsApp na V1 — o painel web fica reservado para
# quem tem profiles.is_admin = true (setado via SQL direto, nunca pelo
# próprio usuário). Deixar CUSTOMER_PANEL_ENABLED ausente/false é o padrão
# da V1. Nenhuma rota do painel foi removida — só fica atrás dessa flag.
CUSTOMER_PANEL_ENABLED=false
ADMIN_PANEL_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────
# Camada 6 (Fase C) — disparo dos alertas agendados
# ─────────────────────────────────────────────────────────────────────────
# Segredo próprio (gerar com `openssl rand -base64 32`) para autenticar o
# cron que chama /api/alerts/dispatch periodicamente — configure um
# serviço "Cron Job" no Railway apontando para
# "${APP_URL}/api/alerts/dispatch?token=<este valor>" (ver
# docs/camada-6-whatsapp-v1.md para o passo a passo). Nunca commitar o
# valor real.
# ALERTS_DISPATCH_SECRET=
