# Frota IA Assistente
#
# Fase 1 (chat com respostas simuladas) não precisa de nenhuma variável.
#
# Fase 2 (integração com a Claude API) — reservada, ainda não lida em
# nenhum lugar do código:
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Camada 3 — Supabase (identidade, dados e memória do cliente)
# ─────────────────────────────────────────────────────────────────────────
# Projeto Supabase próprio e isolado do Frota IA (não é o mesmo projeto do
# ZapFlow). URL e publishable key são seguras para o navegador — por isso o
# prefixo NEXT_PUBLIC_. A secret key NUNCA leva esse prefixo e nunca deve
# aparecer em código client-side.

NEXT_PUBLIC_SUPABASE_URL=https://kqquswdrtcqicyfcvvuv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_rijl-1HgEgArx4kDKCSg9A_iCwPsT7q

# Secret key (antigo "service role"). Somente backend — nunca no navegador,
# nunca em log, nunca com prefixo NEXT_PUBLIC_. Pegue o valor real no painel
# do Supabase (Project Settings > API Keys) e cole apenas no seu .env local
# (nunca neste arquivo .env.example, nunca commitado).
# SUPABASE_SECRET_KEY=

# Referência do projeto (usada por scripts/CLI, não em runtime da aplicação).
SUPABASE_PROJECT_REF=kqquswdrtcqicyfcvvuv

# ─────────────────────────────────────────────────────────────────────────
# Login com Google (via Supabase Auth) — preparado, pendente de credenciais
# ─────────────────────────────────────────────────────────────────────────
# O client secret do Google fica configurado no painel do Supabase
# (Authentication > Providers > Google), não é lido diretamente pelo
# Next.js. As variáveis abaixo documentam o que precisa existir e, quando
# preenchidas, permitem exibir o Client ID/URI de redirect na própria UI se
# necessário. Nunca commitar valores reais.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://kqquswdrtcqicyfcvvuv.supabase.co/auth/v1/callback
